# Use the Pi's LAN address to allow access from your phone on the same network.
BIND_ADDRESS=127.0.0.1
PORT=8090
# Use latest or a published sha-<commit> tag for both images.
IMAGE_TAG=latest
# Optional existing HTTP/SOCKS proxy for YouTube; keep credentials out of Git.
YOUTUBE_PROXY=
# Preserve original AAC; false uses the MP3 192 kbps compatibility path.
AUDIO_PASSTHROUGH=true
# Initial AAC audio sent immediately (3..8 seconds), not a startup wait.
AUDIO_STARTUP_SECONDS=8
